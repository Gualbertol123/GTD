{
  "name": "team-gtd-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "TEAM GTD FINALE — realtime collaborative GTD + Kanban board",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-pdf-fonts.mjs && tsc -b && tsc -p netlify/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p netlify/tsconfig.json",
    "perf:music": "node scripts/perf/run.mjs",
    "perf:music:check": "node scripts/perf/run.mjs --check --label check --reps 1 --only S2,S3,S4,S8,S9,S14",
    "perf:fns": "node scripts/perf/fns.mjs",
    "perf:match": "node scripts/perf/match-rate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.45.0",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
